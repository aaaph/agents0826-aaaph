# Copy to deploy/.env and fill in. deploy/.env is gitignored — NEVER commit it.

# Team Neo4j password (set once; share with the team out-of-band, not via git).
NEO4J_PASSWORD=change-me-strong-team-password

# Target host for deploy.sh
DEPLOY_HOST=<DEPLOY_USER>@<NEO4J_HOST>

# Bolt URI the team points HOOKS_NEO4J_URI at (informational; used by verify step)
HOOKS_NEO4J_URI=bolt://<NEO4J_HOST>:7687
HOOKS_NEO4J_USER=neo4j
